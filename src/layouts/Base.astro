---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Per-page social image. Defaults to the site card. */
  image?: string;
}
const { title, description, image = '/og.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// og:image must be absolute: crawlers do not resolve relative URLs.
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- An SVG favicon carries its own prefers-color-scheme, so the mark stays
         visible against both browser chromes. The 180px PNG is for iOS, which
         does not accept SVG. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#3d5a80" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="superblock" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- 1200x670, not the oft-quoted 1200x630. The card is 16:9 and forcing it
         into 1.905 crops top and bottom, which sliced the title block in half.
         1200x630 is a recommendation, not a requirement; every major crawler
         honours the declared dimensions. -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="670" />
    <meta property="og:image:alt" content="An engineering drawing sheet titled PLATFORM ARCHITECTURE, superblock.dev" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site">
      <div class="wrap inner">
        <a class="brand" href="/">superblock</a>
        <nav>
          <a href="/#practice">Practice</a>
          <a href="/#platform">Platform</a>
          <a href="/#product">Product</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site">
      <div class="wrap">
        Architecture diagrams rendered from D2 sources. Network addresses redacted.<br />
        <a href="https://fluency.study">fluency.study</a> &middot;
        <a href="https://jrcodex.dev">jrcodex.dev</a> &middot;
        <a href="https://github.com/Tobiscuit">github.com/Tobiscuit</a>
      </div>
    </footer>
  </body>
</html>
